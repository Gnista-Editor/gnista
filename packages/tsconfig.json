{
  // Lets `tsc -p packages` check Ember's own packages against ember.d.ts,
  // with the same settings Ember writes for a user's config directory.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    // Each .ts file is its own module, as Ember runs each file in its own scope.
    "moduleDetection": "force",
    // Ember erases types rather than compiling them, so enums and the like are not allowed.
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
