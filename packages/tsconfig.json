{
  // Lets `tsc -p packages` check Gnista's own packages against gnista.d.ts,
  // with the same settings Gnista writes for a user's config directory.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    // Each .ts file is an ES module, importing others by feature name, as
    // Lisp files require each other: "subr" is subr.ts.
    "moduleDetection": "force",
    "module": "preserve",
    "paths": { "*": ["./*"] },
    // Gnista erases types rather than compiling them, so enums and the like are not allowed.
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
