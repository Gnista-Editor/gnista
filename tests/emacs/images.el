;;; images.el --- Record what a graphical Emacs answers about images  -*- lexical-binding: t -*-

;; Batch Emacs and Emacs on a terminal cannot load images: image-size and
;; the rest signal "Window system frame should be used".  So this runs in
;; a graphical Emacs, which opens a frame for a moment, records the
;; answers the tests in crates/ember-core/tests/images.rs and
;; crates/ember-script/tests/images.rs compare with, and quits:
;;
;;   emacs -Q -l $PWD/tests/emacs/images.el
;;
;; (an absolute name, as Emacs's Mac port starts in the home directory).
;; The answers go to target/image-answers.el, one (NAME . ANSWER) a line.
;; The tests' metrics are those of the frame it ran in: Emacs 30.2's NS
;; port with Menlo at 12 pixels, 7 wide, 14 high and 11 above the baseline.

(defvar probe-dir (expand-file-name "../../crates/ember-core/tests/images/" (file-name-directory load-file-name)))
(defvar probe-out (expand-file-name "../../target/image-answers.el" (file-name-directory load-file-name)))
(defun probe-try (f)
  (condition-case err (funcall f) (error (list 'error err))))
(defun img (file &rest props)
  (apply #'create-image (concat probe-dir file) nil nil props))
(defvar probe-results nil)
(defmacro probe (name form)
  `(push (cons ',name (probe-try (lambda () ,form))) probe-results))

(defun probe-run ()
  (let ((frame (selected-frame)))
    (probe frame-char (list (frame-char-width) (frame-char-height)))
    (probe font (let ((f (font-info (face-font 'default)))) (list (aref f 2) (aref f 3) (aref f 4) (aref f 5) (aref f 8) (aref f 1))))
    (probe transforms (image-transforms-p))
    (probe types image-types)
    (probe image (img "red-blue.png"))
    (probe size-chars (image-size (img "red-blue.png")))
    (probe size-px (image-size (img "red-blue.png") t))
    (probe size-jpg (image-size (img "stripes.jpg") t))
    (probe size-gif (image-size (img "blink.gif") t))
    (probe size-svg (image-size (img "shapes.svg") t))
    (probe size-svg-scale (image-size (img "shapes.svg" :scale 1.5) t))
    (probe size-svg-width (image-size (img "shapes.svg" :width 25) t))
    (probe size-scale2 (image-size (img "red-blue.png" :scale 2) t))
    (probe size-scale-odd (image-size (img "red-blue.png" :scale 0.3) t))
    (probe size-width (image-size (img "red-blue.png" :width 64) t))
    (probe size-height (image-size (img "red-blue.png" :height 8) t))
    (probe size-width-height (image-size (img "red-blue.png" :width 10 :height 30) t))
    (probe size-width-scale (image-size (img "red-blue.png" :width 10 :scale 2) t))
    (probe size-max-width (image-size (img "red-blue.png" :max-width 20) t))
    (probe size-max-height (image-size (img "red-blue.png" :max-height 4) t))
    (probe size-max-width-scale (image-size (img "red-blue.png" :max-width 20 :scale 3) t))
    (probe size-width-max (image-size (img "red-blue.png" :width 50 :max-width 20) t))
    (probe size-em (image-size (img "red-blue.png" :width '(2 . em)) t))
    (probe size-ch (image-size (img "red-blue.png" :height '(1 . ch)) t))
    (probe size-margin (image-size (img "red-blue.png" :margin 3) t))
    (probe size-margin-pair (image-size (img "red-blue.png" :margin '(2 . 5)) t))
    (probe size-margin-chars (image-size (img "red-blue.png" :margin 3)))
    (probe size-relief (image-size (img "red-blue.png" :relief 2) t))
    (probe size-rot90 (image-size (img "red-blue.png" :rotation 90) t))
    (probe size-rot180 (image-size (img "red-blue.png" :rotation 180) t))
    (probe size-rot45 (image-size (img "red-blue.png" :rotation 45) t))
    (probe size-rot90-scale (image-size (img "red-blue.png" :rotation 90 :width 64) t))
    (probe size-missing (image-size (img "missing.png") t))
    (probe size-missing-wh (image-size (create-image "/nonexistent/x.png" 'png nil :width 12 :height 7) t))
    (probe size-relative (image-size (create-image "red-blue.png" 'png) t))
    (probe size-data (image-size (create-image (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally (concat probe-dir "dot.png")) (buffer-string)) nil t) t))
    (probe mask-dot (image-mask-p (img "dot.png")))
    (probe mask-redblue (image-mask-p (img "red-blue.png")))
    (probe mask-svg (image-mask-p (img "shapes.svg")))
    (probe mask-gif (image-mask-p (img "blink.gif")))
    (probe meta-gif (image-metadata (img "blink.gif")))
    (probe meta-png (image-metadata (img "red-blue.png")))
    (probe meta-jpg (image-metadata (img "stripes.jpg")))
    (probe imagep-keyword (imagep '(image :type png :file "a" :foo 1)))
    (probe imagep-ascent-center (imagep '(image :type png :file "a" :ascent center)))
    (probe imagep-ascent-bad (imagep '(image :type png :file "a" :ascent 120)))
    (probe imagep-margin-neg (imagep '(image :type png :file "a" :margin -1)))
    (probe imagep-width (imagep '(image :type png :file "a" :width 10 :scale 2 :rotation 90 :max-width 3)))
    (probe imagep-svg (imagep '(image :type svg :data "<svg/>")))
    (probe imagep-data-sym (imagep '(image :type png :data foo)))
    (probe cache-size (image-cache-size))
    ;; Layout: a line with text and an image.
    (switch-to-buffer "probe")
    (erase-buffer)
    (insert "ab")
    (insert-image (img "red-blue.png" :scale 4))
    (insert "cd\nnext\n")
    (insert "ef")
    (insert-image (img "red-blue.png" :scale 4 :ascent 100))
    (insert "gh\nnext\n")
    (insert "ij")
    (insert-image (img "red-blue.png" :scale 4 :ascent 'center))
    (insert "kl\nnext\n")
    (insert "mn")
    (insert-image (img "red-blue.png" :scale 4 :ascent 0 :margin 2))
    (insert "op\nnext\n")
    (insert "q")
    (insert-image (img "dot.png"))
    (insert "r\nnext\n")
    (insert "s")
    (put-image (img "dot.png" :scale 4) (point))
    (insert "t\nnext\n")
    (insert "u")
    (insert-sliced-image (img "red-blue.png" :scale 4) "x" nil 2 2)
    (insert "v\nend")
    (goto-char (point-min))
    (redisplay t)
    (probe posns (let (out) (goto-char (point-min))
                      (while (not (eobp))
                        (let ((p (posn-at-point (point))))
                          (push (list (point) (char-after) (posn-x-y p) (posn-object-width-height p) (car-safe (posn-image p))) out))
                        (forward-char 1))
                      (nreverse out)))
    (probe heights (let (out) (goto-char (point-min))
                        (while (not (eobp))
                          (push (list (line-number-at-pos) (line-pixel-height)) out)
                          (forward-line 1))
                        (nreverse out)))
    (probe wtps (window-text-pixel-size nil (point-min) (point-max)))
    (probe wtps-line1 (window-text-pixel-size nil 1 6))
    (probe at-x-y (list (posn-point (posn-at-x-y 30 10)) (posn-point (posn-at-x-y 100 10)) (posn-point (posn-at-x-y 140 10))))
    ;; Moving down from before the image keeps the column.
    (probe next-line (progn (goto-char 2) (next-line) (list (point) (progn (next-line) (point)) (progn (goto-char 4) (next-line) (point)))))
    (probe cache-size-after (image-cache-size))
    (probe messages (with-current-buffer "*Messages*" (buffer-substring-no-properties (point-min) (point-max))))
    (with-temp-file probe-out
      (let ((print-length nil) (print-level nil))
        (dolist (r (nreverse probe-results))
          (prin1 r (current-buffer))
          (insert "\n"))))
    (kill-emacs)))
(make-directory (file-name-directory probe-out) t)
(condition-case err
    (probe-run)
  (error (write-region (format "ERR %S" err) nil probe-out)
         (kill-emacs 1)))
