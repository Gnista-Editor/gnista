{
  // Lets `tsc -p examples/packages` check these packages as a user's are
  // checked: against gnista.d.ts, importing Gnista's own packages by name.
  "extends": "../../packages/tsconfig.json",
  "compilerOptions": {
    "paths": { "*": ["./*", "../../packages/*"] }
  },
  "include": ["*.ts", "../../packages/gnista.d.ts"]
}
