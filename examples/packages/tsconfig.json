{
  // Lets `tsc -p examples/packages` check these packages as a user's are
  // checked: against e8.d.ts, importing E8's own packages by name.
  "extends": "../../packages/tsconfig.json",
  "compilerOptions": {
    "paths": { "*": ["./*", "../../packages/*"] }
  },
  "include": ["*.ts", "../../packages/e8.d.ts"]
}
